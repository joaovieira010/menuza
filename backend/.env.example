DATABASE_URL=postgresql://menuza_app:SUA_SENHA@localhost:5432/menuza
JWT_SECRET=gere_um_segredo_aleatorio_de_pelo_menos_32_caracteres
PORT=3000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
SEED_ADMIN_PASSWORD=defina_uma_senha_forte_para_os_dois_admins_demo
# Exclusivo para testes de integração: banco descartável, nunca produção.
# TEST_DATABASE_URL=postgresql://menuza_app:SUA_SENHA@localhost:5432/menuza_test
# Produção: HOST=0.0.0.0 em containers. APP_ORIGIN precisa ser HTTPS público.
HOST=127.0.0.1
# Só configure proxies que realmente fazem parte da sua infraestrutura.
# TRUST_PROXY=loopback
# UPLOAD_DIR=/var/lib/menuza/uploads
# Provisionamento inicial (remova a senha do ambiente depois de executar superadmin:create).
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=
# Lembretes: endpoint HTTPS seu que encaminhe ao provedor. Deduplicar por Idempotency-Key.
# BILLING_WEBHOOK_URL=
# BILLING_WEBHOOK_TOKEN=
# BACKUP_DIR=/var/lib/menuza/backups
# PG_DUMP_BIN=/usr/bin/pg_dump
# PG_RESTORE_BIN=/usr/bin/pg_restore
# Publicação gratuita: obrigatório em produção; não usar diretório local como fonte.
# IMAGE_STORAGE=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_PREFIX=menuza
# DATABASE_URL de produção: conexão direta do Neon com sslmode=verify-full.
# Homologação: manter desativado; não configurar webhooks de cobrança.
# BILLING_ENABLED=false
