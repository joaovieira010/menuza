{
  "name": "menuza",
  "version": "1.0.0",
  "private": true,
  "description": "Cardápio digital e gestão de pedidos multi-tenant",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start:recovered": "bash scripts/start-recovered.sh",
    "superadmin:setup": "node scripts/setup-superadmin.cjs",
    "migrate": "node backend/src/database/migrate.js",
    "seed": "node backend/src/database/seed.js",
    "dev": "node --watch backend/src/server.js",
    "start": "node backend/src/server.js",
    "test": "jest --runInBand",
    "test:browser": "node backend/tests/browser.cjs",
    "superadmin:create": "node backend/src/database/create-superadmin.js",
    "auth:check": "node scripts/check-login.cjs",
    "billing:run": "node backend/src/services/billing.js",
    "backup": "node scripts/backup.cjs",
    "restore": "node scripts/restore.cjs",
    "test:browser:saas": "node backend/tests/browser-saas.cjs",
    "test:backup": "node backend/tests/backup.cjs",
    "test:browser:regression": "node backend/tests/browser-regression.cjs",
    "format:check": "prettier --check backend/src backend/tests/saas.test.js backend/tests/browser-saas.cjs backend/tests/browser-regression.cjs backend/tests/backup.cjs frontend scripts docs README.md render.yaml package.json",
    "pilot:check": "node scripts/pilot-check.cjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.10.1",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/backend/tests/**/*.test.js"
    ]
  }
}
